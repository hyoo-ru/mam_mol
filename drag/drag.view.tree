$mol_drag $mol_ghost
	event *$mol_view_event
		dragstart? <=> drag_start? <=> start? null
		drag? <=> drag_move? <=> move? null
		dragend? <=> drag_end? <=> end? null
	attr *$mol_view_attr
		draggable true
		mol_drag_status <= status? \ready
	transfer *string
		text/plain <= plain <= title
		text/html <= html \
		text/uri-list <= uris \
	allow_copy true
	allow_link true
	allow_move true
	image <= dom_node
